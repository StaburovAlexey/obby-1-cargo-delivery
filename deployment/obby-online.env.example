HOST=127.0.0.1
PORT=8081
MAX_CONNECTIONS=2000
MAX_ROOMS=100
# Set real game origins before launch, comma-separated, with no trailing slash.
# Exact origins and scheme-bound *.subdomain patterns are supported.
# For a Yandex draft, read the actual iframe origin and add only that required
# origin or the hosting suffix approved for this deployment. No credentials here.
ALLOWED_ORIGINS=https://game.example.com
