FROM node:22.23.3-alpine
WORKDIR /app
COPY package.json ./
COPY dist/premium-skins.js ./dist/
COPY server/vk-*.mjs server/vk-products.json ./server/
RUN mkdir /data && chown node:node /data
ENV NODE_ENV=production VK_HOST=0.0.0.0 VK_PORT=8085 VK_DATABASE_PATH=/data/purchases.sqlite
USER node
EXPOSE 8085
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD node -e "fetch('http://127.0.0.1:8085/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server/vk-server.mjs"]
