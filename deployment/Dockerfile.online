FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

FROM node:22-alpine AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8081 WORKERS=4 MAX_CONNECTIONS_PER_WORKER=500 MAX_ROOMS_PER_WORKER=25
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json ./
COPY dist/*.js ./dist/
COPY server/room-server.mjs server/room-cluster.mjs ./server/
RUN node --input-type=module -e "await import('./server/room-server.mjs'); await import('./server/room-cluster.mjs')"
USER node
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD node -e "fetch('http://127.0.0.1:8081/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server/room-cluster.mjs"]
